# Required: backend base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Optional: default LLM model name sent with every message.
# The backend uses this to route to the correct LLM worker.
# Change to match whatever model your vLLM server is serving.
VITE_DEFAULT_MODEL=Qwen/Qwen3.5-0.8B
