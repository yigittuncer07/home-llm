# database
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=homellm
DB_HOST=db
DB_PORT=5432

# security
JWT_KEY=testtesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttest

# external services
REDIS_HOST=redis
# Note: if you use the llamacpp profile, ensure your models.yaml points to http://llamacpp:8001
LLM_API_BASE=http://llamacpp:8001

# host ports mapping
FRONTEND_PORT=3000
BACKEND_PORT=8000
NGINX_PORT=80
REDIS_PORT=6379
LLM_PORT=8001 # port for local LLM server, make sure it matches backend/models.yaml

# local LLM configuration
LLM_MAX_LEN=4096 # be sure to change the max value in backend/models.yaml if you change this

# Note: If you plan to use .gguf files (which are highly recommended for home hardware), 
# opt for Option B and launch with the 'llamacpp' docker profile.

# Option A: vLLM (standard models)
LLM_MODEL=Qwen/Qwen3.5-0.8B

# Option B: llama.cpp (GGUF files)
LLM_HF_REPO=unsloth/Qwen3.5-0.8B-GGUF
LLM_HF_FILE=Qwen3.5-0.8B-Q4_K_M.gguf

# admin setup
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin