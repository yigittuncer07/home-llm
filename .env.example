# database
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=homellm
DB_HOST=db
DB_PORT=5432

# security
JWT_KEY=testtesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttest

# external services
REDIS_HOST=redis
LLM_API_BASE=http://vllm:8001

# host ports mapping
FRONTEND_PORT=3000
BACKEND_PORT=8000
NGINX_PORT=80
REDIS_PORT=6379
LLM_PORT=8001 # port for vLLM server, make sure it is the same as the port in backend/models.yaml

# vLLM configuration
LLM_MODEL=Qwen/Qwen3.5-0.8B # change backend/models.yaml if you change this value
LLM_MAX_LEN=4096 # be sure to change the max value under vllm in backend/models.yaml if you change this value
LLM_MAX_SEQS=4
LLM_GPU_UTIL=0.95            # fraction of VRAM vLLM is allowed to use
LLM_QUANTIZATION=            # leave blank for fp16, set to "bitsandbytes" for on-the-fly 4-bit quantization on small GPUs
LLM_ENFORCE_EAGER=           # leave blank for normal mode, set to "1" to disable torch.compile/CUDA graphs on tight VRAM

ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin